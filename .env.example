# LLM Sched Copilot — runtime environment template.
#
# Copy this file to `.env` (same directory) and fill in your own key:
#   cp .env.example .env
#
# .env is in .gitignore and must NEVER be committed.
# .env.example must only contain placeholders.

# --- Runtime LLM backend: Upstage Solar Pro 3 -------------------------------
# The project's runtime LLM calls (recommendation, trace explanation,
# feedback-rule generation) all go through tools/solar_client.py against
# the Upstage Solar Pro 3 chat-completions endpoint.
#
# Get a key at: https://console.upstage.ai/
UPSTAGE_API_KEY=your_upstage_api_key_here

# Optional overrides — leave commented to use the defaults baked into
# tools/solar_client.py (model=solar-pro3, base_url=https://api.upstage.ai/v1).
# SOLAR_MODEL=solar-pro3
# SOLAR_BASE_URL=https://api.upstage.ai/v1

# --- NOT runtime backends ---------------------------------------------------
# Claude Code is used only as the development coding agent in the editor.
# Do NOT add ANTHROPIC_API_KEY or OPENAI_API_KEY here — they are not used
# by the runtime pipeline and committing them would leak a secret.
