# LLM Sched Copilot — per-tool environment template.
#
# The canonical example lives at the project root (.env.example);
# this file exists because tools/solar_client.py also searches
# tools/.env (before project-root .env). Pick whichever location
# is convenient — both are git-ignored when named .env.
#
# Copy this file next to it as `.env` and add your real key:
#   cp tools/.env.example tools/.env
#
# NEVER commit a real key. .env is git-ignored.

# Required — your Upstage Solar Pro 3 API key.
# Get one at: https://console.upstage.ai
UPSTAGE_API_KEY=your_upstage_api_key_here

# Optional overrides (defaults shown).
SOLAR_MODEL=solar-pro3
SOLAR_BASE_URL=https://api.upstage.ai/v1
