# API keys — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Build outputs (xv6 raw logs, build logs, demo scratch).
# Use `outputs/*` (not `outputs/`) so the directory itself stays visible to
# git — otherwise the `!` exception below cannot re-include anything inside.
outputs/*
# …but the curated offline-demo fixture set is committed. The leading
# underscore + "_fixtures" suffix is intentional: it reads as "committed
# data", not "build output of demo". See docs/repo_cleanup_plan.md §6.2.
!outputs/_demo_fixtures/
# Burst-prediction ablation evidence (report + reproducibility cache) is a
# committed presentation deliverable, like the demo fixtures above. Regenerate
# with `python3 experiments/burst_ablation.py [--advise]`.
!outputs/ablation/
# Retrieval-learning RESULTS.md is likewise committed evidence; the bulky LLM
# response cache + raw json under outputs/learning/ stay ignored (regeneratable
# via experiments/recommendation_eval.py).
!outputs/learning/
outputs/learning/*
!outputs/learning/RESULTS.md
# Adaptive (observe-then-adapt) negative-result evidence — keep the RESULTS doc;
# the bulky json + xv6 probe logs stay ignored (regeneratable).
!outputs/adaptive/
outputs/adaptive/*
!outputs/adaptive/RESULTS.md
# Random-workload burst-prediction study — keep the RESULTS doc + the two small
# aggregate JSONs; the LLM prediction cache and bulky xv6 run logs stay ignored
# (regeneratable via experiments/burst_random_eval.py).
!outputs/random_eval/
outputs/random_eval/*
!outputs/random_eval/RESULTS.md
!outputs/random_eval/burst_random_eval.json
!outputs/random_eval/scout_multi.json
# Natural-language intent → config evidence — keep the RESULTS doc + the eval
# JSON; the LLM cache stays ignored (regeneratable via experiments/intent_eval.py).
!outputs/intent_eval/
outputs/intent_eval/*
!outputs/intent_eval/RESULTS.md
!outputs/intent_eval/intent_eval.json
# Adaptive learning-curve study — the measured source behind the dashboard
# Learning tab and the presentation Result chart. Keep the evidence docs + the
# aggregate results.json; the xv6 raw logs and the instance bank stay ignored
# (regeneratable via experiments/learning_curve_bank|replay|llm.py).
!outputs/learning_curve/
outputs/learning_curve/*
!outputs/learning_curve/RESULTS.md
!outputs/learning_curve/FINDINGS.md
!outputs/learning_curve/results.json

# Defensive: catch stray logs outside outputs/. Tracked files (e.g.
# logs/foo.log if someone deliberately git-added one) are unaffected.
*.log

# Node — each dashboard also has its own .gitignore covering these,
# but keep them at root so a fresh subdir doesn't slip past.
node_modules/
dist/
.vite/
*.local

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
